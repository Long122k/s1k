[Unit]
Description=Gia1K crawler — sinh data.json từ shopee1k.com + nghienshopee.net
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/s1k
Environment=OUTPUT_FILE=/home/ubuntu/s1k/data.json
ExecStart=/home/ubuntu/s1k/.venv/bin/python /home/ubuntu/s1k/getdeal1k.py
# Crawler đôi khi treo (network) → giới hạn thời gian chạy
TimeoutStartSec=120
Nice=10

# Siết bảo mật (chạy dịch vụ nền tối thiểu quyền)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/s1k

[Install]
WantedBy=multi-user.target
